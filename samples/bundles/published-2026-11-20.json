              },
              "text": "plain yoghurt"
            },
            {
              "amount": {
                "text": "1/2 tsp",
                "quantity": 0.5,
                "unit": "tsp"
              },
              "text": "salt"
            },
            {
              "amount": {
                "text": "1 tbsp",
                "quantity": 1,
                "unit": "tbsp"
              },
              "text": "oil"
            },
            {
              "amount": null,
              "text": "Some oil, for greasing the skillet"
            },
            {
              "amount": {
                "text": "3 tbsp",
                "quantity": 3,
                "unit": "tbsp"
              },
              "text": "melted butter, to brush with"
            }
          ]
        }
      ],
      "method": [
        [
          "In a small bowl, stir ",
          {
            "amount": {
              "text": "1 tsp",
              "quantity": 1,
              "unit": "tsp"
            },
            "ingredient": "sugar"
          },
          ", ",
          {
            "amount": {
              "text": "120ml",
              "quantity": 120,
              "unit": "ml"
            },
            "ingredient": "warm water"
          },
          " and ",
          {
            "amount": {
              "text": "7g",
              "quantity": 7,
              "unit": "g"
            },
            "ingredient": "yeast"
          },
          " together. The yeast should be activated when it becomes foamy, about 10 minutes. Put ",
          {
            "amount": {
              "text": "270g",
              "quantity": 270,
              "unit": "g"
            },
            "ingredient": "flour"
          },
          " on a flat surface and make a well in the middle. Add the yeast mixture, ",
          {
            "amount": {
              "text": "125g",
              "quantity": 125,
              "unit": "g"
            },
            "ingredient": "yoghurt"
          },
          ", ",
          {
            "amount": {
              "text": "1/2 tsp",
              "quantity": 0.5,
              "unit": "tsp"
            },
            "ingredient": "salt"
          },
          " and ",
          {
            "amount": {
              "text": "1 tbsp",
              "quantity": 1,
              "unit": "tbsp"
            },
            "ingredient": "oil"
          },
          ", and knead the dough until the surface becomes smooth and shiny, about 10 minutes. Cover the dough and let it rise in a warm place (for example beside the stovetop or a warm oven) until doubled in size, about 1 hour."
        ],
        [
          "Divide the dough into 8 equal portions. Roll each into an 8\" circle with a rolling pin."
        ],
        [
          "Heat a skillet (cast-iron preferred) over high heat and lightly grease it with oil so the dough doesn't stick. Place a dough circle on the skillet. When it puffs up and bubbles and burnt spots appear, flip it over and cook the other side. Repeat until all the dough is done."
        ],
        [
          "Brush the naan with ",
          {
            "amount": {
              "text": "3 tbsp",
              "quantity": 3,
              "unit": "tbsp"
            },
            "ingredient": "melted butter"
          },
          " and serve warm."
        ]
      ],
      "notes": [],
      "source": null
    },
