                "text": "7g",
                "quantity": 7,
                "unit": "g"
              },
              "text": "active dry yeast"
            },
            {
              "amount": {
                "text": "270g",
                "quantity": 270,
                "unit": "g"
              },
              "text": "all-purpose flour"
            },
