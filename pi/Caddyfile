# The Kitchen Display Pi's web server: plain HTTP on the LAN, static files only (ADR 0002).
# pi/setup.sh installs this as /etc/caddy/Caddyfile; `food deploy` runs it.

:80 {
	# Revalidate on every load, so the Boox picks up a new page or bundle straight away.
	header Cache-Control no-cache

	# The display bundle and its version file come from the release `food publish` last switched `current` to.
	@release path *.json
	handle @release {
		root * /srv/kitchen/current
		file_server
	}

	# Everything else is the page `food deploy` uploaded.
	handle {
		root * /srv/kitchen/page
		file_server
	}
}
